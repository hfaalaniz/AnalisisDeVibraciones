<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VibrationAnalysis.UI</RootNamespace>
    <AssemblyName>AnalisisVibraciones</AssemblyName>
    <Version>2.2.0</Version>
    <Authors>Fabian Alaniz</Authors>
    <Company>ElectroNet</Company>
    <Product>Análisis de Vibraciones y Balanceo</Product>
    <Copyright>© 2025 Fabian Alaniz</Copyright>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Permite compilar (no ejecutar) en Linux/macOS para verificación -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VibrationAnalysis.Core\VibrationAnalysis.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
</Project>
