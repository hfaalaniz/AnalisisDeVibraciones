<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VibrationAnalysis.Core</RootNamespace>
    <AssemblyName>VibrationAnalysis.Core</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>Fabian Alaniz</Authors>
    <Company>ElectroNet</Company>
    <Product>Análisis de Vibraciones y Balanceo</Product>
    <Description>Núcleo de cálculo: FFT, severidad ISO, diagnóstico de fallas y balanceo por coeficientes de influencia.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
</Project>
